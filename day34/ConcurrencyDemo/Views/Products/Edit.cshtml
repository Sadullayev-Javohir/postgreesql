@model ConcurrencyDemo.Models.Product

@{
  ViewData["Title"] = "Edit Product";
}

<h1 class="mb-4">Edit Product</h1>

<form asp-action="Edit" method="post" class="mt-3">
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>

  <div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control">
    <span asp-validation-for="Name" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Price" class="form-control"></label>
    <input asp-for="Price" class="form-control">
    <span asp-validation-for="Price" class="text-danger"></span>
  </div>

  <input type="hidden" asp-for="Id">
  <input type="hidden" asp-for="xmin">

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-success">Cancel</a>
  </div>
</form>
