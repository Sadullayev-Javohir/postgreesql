@model IEnumerable<Product>
@{
  ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (TempData["Success"] != null)
{
  <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
  <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
  <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<table class="table table-bordered table-striped">
  <thead>
    <tr>
      <th>Id</th>
      <th>Name</th>
      <th>Price</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var p in Model)
    {
      <tr>
        <td>@p.Id</td>
        <td>@p.Name</td>
        <td>@p.Price</td>
        <td>
          <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@p.Id">Details</a>
          <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
          <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.Id">Delete</a>
        </td>
      </tr>
    }
  </tbody>
</table>
